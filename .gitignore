# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editor / IDE ----
.vscode/
*.code-workspace
*.swp
*.swo
*~

# ---- Logs & temp ----
*.log
*.tmp
tmp/
temp/

# ---- Local dev servers / tooling (not needed for a static site) ----
__pycache__/
.cache/
node_modules/

# ---- Environment / secrets (never commit) ----
.env
.env.*
*.pem
*.key

# NOTE: do NOT ignore CNAME or .nojekyll — GitHub Pages needs them committed.
